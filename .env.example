# Required
TELEGRAM_BOT_TOKEN=
# Numeric Telegram ID of the owner (e.g. from @userinfobot). Bot refuses to start without it
OWNER_ID=

# Primary LLM provider (Polza.ai, OpenAI-compatible)
POLZA_API_KEY=
POLZA_BASE_URL=https://api.polza.ai/v1

# Optional
# Raises GitHub API limit 60 -> 5000 req/h
GITHUB_TOKEN=
# Daily Habr digest send time, HH:MM in Moscow time (MSK). Default 18:00;
# an invalid value falls back to 18:00 with a warning in the log
DIGEST_TIME=18:00
