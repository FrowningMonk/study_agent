# Required
TELEGRAM_BOT_TOKEN=
# Numeric Telegram ID of the owner (e.g. from @userinfobot). Bot refuses to start without it
OWNER_ID=

# Primary LLM provider (Polza.ai, OpenAI-compatible)
POLZA_API_KEY=
POLZA_BASE_URL=https://api.polza.ai/v1

# Optional
# Raises GitHub API limit 60 -> 5000 req/h
GITHUB_TOKEN=
